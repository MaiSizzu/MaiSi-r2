# 8 卡 / 124 帧 / 50 步的标准开关。
# 用法：cp env/h3.env.example $AFS/h3.env        （$AFS 未设时就是 ~/h3.env）
# run.sh 每单开头会 load 这个文件；已 export 的同名变量优先，不会被文件覆盖。
# 没有这个文件也能跑，但会退回内置默认：LEGACY_GPUS=0,1,2,3、LEGACY_MEM_FRAC=0.4，
# 即 4 卡 —— 与报告里的 8 卡口径不一致，出片和耗时都对不上。

# VAE 解码走纯 matmul（native 会去加载不存在的 flash_attn_2_cuda）
DIFFUSERS_ATTN_BACKEND=_native_math

# 视频 VAE 强制 fp32 解码（消彩色过饱和块；音频 VAE 不动）
H3_VAE_FP32=1

# 8 卡：文本塔单独占 device 0，DiT TP=8 用 1~7
LEGACY_GPUS=0,1,2,3,4,5,6,7
LEGACY_MEM_FRAC=0.82
LEGACY_TEXT_GPUS=0
LEGACY_TRANSFORMER_GPUS=1,2,3,4,5,6,7

# compare 复用（首次复现不用开：那时还没有我方片子可复用）
# H3_REUSE_OURS=1
# H3_FORCE_REF=0
