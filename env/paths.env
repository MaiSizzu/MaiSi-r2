# Model and data path configuration. Every value can be overridden by the environment.
# Usage: source env/paths.env

# FL2VA weight root: a diffusers-style directory (model_index.json + transformer weights).
# Weights are NOT shipped with this package (~135 GB).
# 权重不在包里（约 135 GB）。设成你环境里 diffusers 风格的目录（含 model_index.json）。
# run.sh 会优先用这个值；留空才走它自己的路径探测。
export MODEL_ROOT=${MODEL_ROOT:-}

# First frame image, required by FL2VA. User provided jpg/png.
export FIRST_FRAME=${FIRST_FRAME:-./inputs/first_frame.png}

# Output directory for generated videos
export OUTPUT_DIR=${OUTPUT_DIR:-./outputs}

# Inference parameters, identical to the official instructions
export PROMPT=${PROMPT:-A dog falls asleep}
export NUM_FRAMES=${NUM_FRAMES:-124}
export STEPS=${STEPS:-50}
export GPUS=${GPUS:-0,1,2,3}

# 可选的 ninetoothed virtualenv。留空 = 用当前 PATH 里的 python3。
# 之前这里写死了一个具体账号下的 venv，换人复现时路径必然不存在。
export H3_VENV=${H3_VENV:-}
